{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/search", "destination": "/search.html" },
    { "source": "/wishlist", "destination": "/wishlist.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/payment", "destination": "/payment.html" },
    { "source": "/order-success", "destination": "/order-success.html" },
    { "source": "/product/:id*", "destination": "/product.html" }
  ]
}
